#ifdef GL_ES
precision mediump float;
#endif

uniform vec2 iResolution;
varying vec2 v_texCoord;
uniform sampler2D u_texture;
varying vec2 v_uv;
// ------------------- SDF 函数 -------------------
float sdCircle(in vec2 p, in float r) {
    return length(p) - r;
}

float sdEllipse(in vec2 p, in vec2 ab) {
    p = abs(p);
    if(p.x > p.y) {
        p = p.yx;
        ab = ab.yx;
    }
    float l = ab.y * ab.y - ab.x * ab.x;
    float m = ab.x * p.x / l;
    float m2 = m * m;
    float n = ab.y * p.y / l;
    float n2 = n * n;
    float c = (m2 + n2 - 1.0) / 3.0;
    float c3 = c * c * c;
    float q = c3 + m2 * n2 * 2.0;
    float d = c3 + m2 * n2;
    float g = m + m * n2;
    float co;
    if(d < 0.0) {
        float h = acos(q / c3) / 3.0;
        float s = cos(h);
        float t = sin(h) * sqrt(3.0);
        float rx = sqrt(-c * (s + t + 2.0) + m2);
        float ry = sqrt(-c * (s - t + 2.0) + m2);
        co = (ry + sign(l) * rx + abs(g) / (rx * ry) - m) / 2.0;
    } else {
        float h = 2.0 * m * n * sqrt(d);
        float s = sign(q + h) * pow(abs(q + h), 1.0 / 3.0);
        float u = sign(q - h) * pow(abs(q - h), 1.0 / 3.0);
        float rx = -s - u - c * 4.0 + 2.0 * m2;
        float ry = (s - u) * sqrt(3.0);
        float rm = sqrt(rx * rx + ry * ry);
        co = (ry / sqrt(rm - rx) + 2.0 * g / rm - m) / 2.0;
    }
    vec2 r = ab * vec2(co, sqrt(1.0 - co * co));
    return length(r - p) * sign(p.y - r.y);
}

float sdOrientedBox(in vec2 p, in vec2 a, in vec2 b, float th) {
    float l = length(b - a);
    vec2 d = (b - a) / l;
    vec2 q = (p - (a + b) * 0.5);
    q = mat2(d.x, -d.y, d.y, d.x) * q;
    q = abs(q) - vec2(l, th) * 0.5;
    return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0);
}

vec2 fixUV(in vec2 c) {
    vec2 uv = (2. * c - iResolution.xy);
    uv /= min(iResolution.x, iResolution.y);
    uv += vec2(0., .15);
    uv *= .8;
    return uv;
}

vec3 plot(float dist, vec3 bgColor, vec3 shapeColor) {
    vec3 color = bgColor;
    float d = smoothstep(.01, .009, abs(dist));
    color = mix(shapeColor, color, step(0., dist));
    color = mix(color, vec3(0.), d);
    return color;
}

float face(vec2 uv) {
float d;
d = sdEllipse(uv + vec2(.2, 0.), vec2(.3, .5));
d = min(d, sdEllipse(uv - vec2(.2, 0.), vec2(.3, .5)));
d = min(d, sdEllipse(uv + vec2(0., .1), vec2(.3, .45)));
d = min(d, sdEllipse(uv - vec2(0., .35), vec2(.38, .2)));
return d;
}

vec3 frontFace(vec2 uv, vec3 bgColor) {
float d = sdEllipse(uv, vec2(.41, .46));
d = max(-1. * sdEllipse(uv + vec2(0., .1), vec2(.42, .19)), d);
d = max(-1. * sdEllipse(uv + vec2(0., .32), vec2(.62, .4)), d);

vec3 color = bgColor;
float f = 1. - step(0., d);
color = mix(color, vec3(1., .92, .84), f);
color = mix(color, vec3(1., .73, .55), f * smoothstep(.05, 0., sdCircle(uv - vec2(.25, .03), .1)));
color = mix(color, vec3(1., .73, .55), f * smoothstep(.05, 0., sdCircle(uv - vec2(-.25, .03), .1)));
color = mix(color, vec3(0.), smoothstep(.01, .009, abs(d)));
return color;
}

float Segment(in vec2 p, vec2 a, vec2 b, float w) {
    vec2 ba = b - a;
    vec2 pa = p - a;
    vec2 d = pa - clamp(dot(pa, ba) / dot(ba, ba), 0., 1.) * ba;
    return smoothstep(w, .99 * w, length(d));
}

vec3 hat(vec2 uv, vec3 bgColor) {
vec3 color = bgColor;
float d1 = sdCircle(uv - vec2(0.15, .35), .5);
float d2 = sdOrientedBox(uv, vec2(-0.5, -0.5), vec2(1.5, .5), 1.4);
float d3 = sdEllipse(uv - vec2(0.1, .4), vec2(.2, .3));
float d4 = sdOrientedBox(uv, vec2(-0.5, 0.), vec2(-0.5, 1.), .5);
color = plot(max(-d2, d1), color, vec3(1., 0., 0.));
color = mix(vec3(1., 0., 0.), color, smoothstep(0., .01, max(-d4, d3)));
color = mix(color, vec3(0.), Segment(uv, vec2(.34, .4), vec2(.2, .7), .01));
color = plot(sdCircle(uv - vec2(.45, .75), .05), color, vec3(1.));
return color;
}

float mouth(vec2 uv) {
float d1 = sdCircle(uv - vec2(0., .07), .25);
float d2 = sdOrientedBox(uv, vec2(-1., .2), vec2(1., .2), .4);
return max(-d2, d1);
}

vec3 santa(vec2 uv) {
vec3 color = vec3(1., .33, .48);
color = hat(uv, color);
color = plot(face(uv), color, vec3(1.));
color = frontFace(uv, color);
color = plot(sdCircle(uv - vec2(0., .09), .05), color, vec3(1., 0., 0.));
color = plot(sdCircle(uv - vec2(.15, .15), .01), color, vec3(0.));
color = plot(sdCircle(uv + vec2(.15, -0.15), .01), color, vec3(0.));
color = plot(mouth(uv + vec2(0., .03)), color, vec3(1., 0., 0.));
return color;
}

#define AA 3

void main() {
    vec4 tex = texture2D(u_texture, v_uv);
    vec3 color = vec3(0.);
    for(int n = 0; n < AA; n++) {
        for(int m = 0; m < AA; m++) {
            vec2 offset = vec2(float(n), float(m)) / float(AA) - .5;
            vec2 uv = fixUV(v_texCoord * iResolution + offset);
            color += santa(uv);
        }
    }
    color /= float(AA * AA);
    gl_FragColor = vec4(color, tex.a);
}
